        "import time\n",
        "#การใช้คณิตศาสตร์ช่วยให้ process ได้ไวขึ้น\n",
        "\n",
        "def seq(n) :\n",
        "\n",
        "  total = 0\n",
        "  for i in range(n) :\n",
        "    total += i + 1\n",
        "  return total\n",
        "\n",
        "# Recursive การเรียกฟังก์ชันของตัวเอง เรียกได้ไม่เกิน 1000 รอบ ประสิทธิภาพไม่ค่อยดี\n",
        "def seq_recur(n) :\n",
        "  if n == 1 :\n",
        "    return 1\n",
        "  return n + seq_recur(n-1)\n",
        "\n",
        "# Math God\n",
        "def math_god(n) :\n",
        "  return int(n/2*(2+(n-1)))\n",
        "\n",
        "n = int(input())\n",
        "start = time.time()\n",
        "print(n,\" times\")\n",
        "print(\"answer seq : \",seq(n))\n",
        "print(\"Time : \", (time.time() - start) * 1000)\n",
        "\n",
        "#start = time.time()\n",
        "#print(\"answer recursive : \",seq_recur(n))\n",
        "#print(\"Time : \", (time.time() - start) * 1000)\n",
        "\n",
        "start = time.time()\n",
        "print(\"answer math god : \",math_god(n))\n",
        "print(\"Time : \", (time.time() - start) * 1000)"
      ],
