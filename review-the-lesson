        "class car :\n",
        "    def __init__(self, make, year, model) :\n",
        "        self.make = make #public variable\n",
        "        self.year = year # public variable\n",
        "        self.model = model # public variable\n",
        "\n",
        "    def get_make(self) :\n",
        "      return self.make\n",
        "\n",
        "    def set_make(self, make) :\n",
        "      self.make = make\n",
        "\n",
        "    def description(self) :\n",
        "      return f\"{self.make} {self.year} {self.model}\"\n",
        "\n",
        "class car_detail :\n",
        "    def __init__(self, wheel, door, material) :\n",
        "      self.wheel = wheel\n",
        "      self.door = door\n",
        "      self.material = material\n",
        "\n",
        "    def description(self) :\n",
        "      return f\"{self.wheel} {self.door} {self.material}\"\n",
        "\n",
        "# class car is parent and car detail is child we can use function from parent\n",
        "\n",
        "car = car(\"Ford\", 2024, \"Hydra\")\n",
        "print(car.description())\n",
        "\n",
        "car_detail = car_detail(4, 4, \"Solid\")\n",
        "print(car_detail.description())"
